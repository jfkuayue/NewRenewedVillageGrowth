SELF_VERSION <- 7               // integer version of the GS, needs to be increased with each release
SELF_MINLOADVERSION <- 6        // minimum integer version of GS that can load this version, increased when major version is increased
SELF_MAJORVERSION <- 0          // main version of the GS, releases with same major version should be saveload compatible
SELF_MINORVERSION <- 7          // minor version of the GS, incremental subreleases of the major version, saveload compatible
SELF_DATE <- "2026-03-24"       // release date [YYYY-MM-DD]
SELF_MAX_TOWNS <- 9999          // maximum number of towns that can be successfully saved in this release - Note: >2000 towns may work unexpectedly
